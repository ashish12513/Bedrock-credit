# Environment Configuration
NODE_ENV=development
PORT=3000

# AWS Bedrock Configuration (REAL)
USE_REAL_BEDROCK=true
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=737185589565

# Cross-Account Configuration (for multi-account access)
CROSS_ACCOUNT_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/BedrockSentinelCrossAccountRole
CROSS_ACCOUNT_EXTERNAL_ID=bedrock-sentinel-governance

# Bedrock Sentinel Governance API (FALLBACK)
GOVERNANCE_API=https://sh0xxez42b.execute-api.us-east-1.amazonaws.com/prod
BEDROCK_PROXY_ENDPOINT=https://sh0xxez42b.execute-api.us-east-1.amazonaws.com/prod/bedrock-invoke

# Application Configuration
APP_NAME=bedrock-sentinel-app
APP_VERSION=1.0.0
ACCOUNT_ID=production-main
DEFAULT_QUALITY=balanced
DEFAULT_TASK_TYPE=default
DEFAULT_MAX_TOKENS=1024

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=*
RATE_LIMIT=100

# Note: For real AWS Bedrock access, ensure:
# 1. AWS credentials are configured (~/.aws/credentials or IAM role)
# 2. Bedrock access is enabled in your AWS account
# 3. Set USE_REAL_BEDROCK=true to use real AWS Bedrock instead of proxy
# 4. For multi-account, configure CROSS_ACCOUNT_ROLE_ARN with actual account ID
